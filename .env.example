# SALVERA Configuration Environment Variables

# Database Connection (Defaults to local SQLite for zero-friction Windows execution)
# To use PostgreSQL, configure your connection string:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/salvera
DATABASE_URL=sqlite:///./data/salvera.db

# Server Configuration
API_PORT=8000
FRONTEND_PORT=5173

# Exchange Rates for Normalization (Against 1 INR)
USD_TO_INR_RATE=83.5
EUR_TO_INR_RATE=90.0
GBP_TO_INR_RATE=106.0
